    {
      "id": 8,
      "type": "piechart",
      "title": "Faturamento por região",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pglab"
      },
      "gridPos": {
        "x": 16,
        "y": 13,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pglab"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT l.regiao AS \"Região\", sum(v.valor_total) AS \"Faturamento\" FROM varejo.vendas v JOIN varejo.lojas l ON l.id = v.loja_id WHERE $__timeFilter(v.data_hora) AND v.status = 'CONCLUIDA' GROUP BY 1 ORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyBRL",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "pieType": "donut",
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "values": [
            "percent"
          ]
        }
      }
    },
