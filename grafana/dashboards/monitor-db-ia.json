            "uid": "pglab"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT date_trunc('day', data_hora) AS time, sum(valor_total) AS \"Faturamento\" FROM varejo.vendas WHERE $__timeFilter(data_hora) AND status = 'CONCLUIDA' GROUP BY 1 ORDER BY 1"
