    {
      "id": 7,
      "type": "timeseries",
      "title": "Faturamento diário (hoje ainda parcial)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pglab"
      },
      "gridPos": {
        "x": 0,
