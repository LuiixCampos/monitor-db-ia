    {
      "id": 21,
      "type": "table",
      "title": "Queries lentas em todos os bancos (última hora)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pglab"
      },
      "gridPos": {
        "x": 0,
        "y": 47,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pglab"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT \"Banco\", \"Tempo médio (ms)\", \"Execuções\", \"Query\" FROM ( SELECT monitor.fn_nome_banco(banco) AS \"Banco\", round(mean_exec_ms) AS \"Tempo médio (ms)\", calls AS \"Execuções\", query AS \"Query\" FROM bi.mon_lentas WHERE atualizado_em > now() - interval '1 hour' UNION ALL SELECT 'PostgreSQL', round(mean_exec_ms), calls, left(query, 300) FROM monitor.vw_top_lentas) t ORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto",
              "wrapText": true
            },
            "inspect": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
