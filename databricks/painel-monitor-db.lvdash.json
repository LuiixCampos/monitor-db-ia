{
  "datasets": [
    {
      "name": "ds_kpi",
      "displayName": "KPIs",
      "queryLines": [
        "SELECT (SELECT count(*) FROM workspace.monitor_db.vw_previsao) AS queries_monitoradas, ",
        "(SELECT count_if(situacao = 'JÁ ESTÁ EM ALTA') FROM workspace.monitor_db.vw_previsao) AS em_alta, ",
        "(SELECT count_if(situacao LIKE 'ATENÇÃO%') FROM workspace.monitor_db.vw_previsao) AS atencao_30d, ",
        "(SELECT count(*) FROM workspace.monitor_db.chamados) AS chamados, ",
        "(SELECT count(ganho_pct) FROM workspace.monitor_db.chamados) AS corrigidos, ",
        "(SELECT round(avg(ganho_pct), 1) FROM workspace.monitor_db.chamados) AS ganho_medio_pct"
      ]
    },
    {
      "name": "ds_diario",
      "displayName": "Tempo médio diário",
      "queryLines": [
        "SELECT date_trunc('DAY', coleta_em) AS dia, banco, round(avg(mean_exec_ms), 1) AS tempo_medio_ms ",
        "FROM workspace.monitor_db.snapshots GROUP BY ALL"
      ]
    },
    {
      "name": "ds_previsao",
      "displayName": "Previsão",
      "queryLines": [
        "SELECT * FROM workspace.monitor_db.vw_previsao ORDER BY dias_ate_alta NULLS LAST, atual_ms DESC"
      ]
    },
    {
      "name": "ds_chamados",
      "displayName": "Chamados",
      "queryLines": [
        "SELECT * FROM workspace.monitor_db.chamados"
      ]
    }
  ],
  "pages": [
