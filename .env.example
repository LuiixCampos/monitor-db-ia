# Copie para .env e troque as senhas. O .env NUNCA vai para o GitHub.
POSTGRES_USER=labadmin
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=lab
MONITOR_PASSWORD=troque_esta_senha_monitor
N8N_ENCRYPTION_KEY=troque_por_um_texto_longo_aleatorio
GRAFANA_PASSWORD=troque_esta_senha_grafana
ORACLE_PASSWORD=TroqueOracle1
ORACLE_APP_PASSWORD=TroqueVarejo1
# SQL Server exige maiúscula, minúscula e número (mínimo 8)
MSSQL_SA_PASSWORD=TroqueSql2026

# Tamanho da base ampliada do PostgreSQL (1 = ~24 milhões de linhas e ~3 GB por ambiente; 0.3 para máquina modesta)
ESCALA_BASE=1

# Esteira DEV/HML/PRD: ganho mínimo em HML para liberar e janela de mudança de PRD (vazio = qualquer hora)
GANHO_MIN_PCT=20
JANELA_PRD=

# IA usada nos diagnósticos: ollama (local, padrão), claude ou azure_openai.
# Com claude/azure_openai, o texto da query e o plano vão para o provedor (a base é fictícia).
IA_PROVEDOR=ollama
IA_FALLBACK_OLLAMA=0
CLAUDE_MODELO=claude-sonnet-5-5
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Chave da API da Anthropic (usada quando IA_PROVEDOR=claude)
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
