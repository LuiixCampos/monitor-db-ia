{
  "name": "Aplicar correções aprovadas",
  "nodes": [
    {
      "parameters": {},
      "id": "2f32dfb2-7fbb-4b23-9b93-47fa7af456c3",
      "name": "Executar manualmente",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "a54ec5d2-e4c4-4fd8-8a9b-6353dc3fbc46",
      "name": "A cada 5 minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {
        "jiraVersion": "cloud",
        "resource": "issue",
        "operation": "getAll",
        "returnAll": true,
        "options": {
          "jql": "labels = monitor-db-ia AND labels = aprovado AND labels not in (corrigido) AND statusCategory != Done",
          "fields": "labels,status"
        }
      },
      "id": "637dd799-5ae7-4eb6-bcd0-2a9f87c908e1",
      "name": "Chamados aprovados",
      "type": "n8n-nodes-base.jira",
      "typeVersion": 1,
      "position": [
        260,
        100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://executor:8000/aplicar",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ jira_key: $json.key }) }}",
        "options": {
          "timeout": 900000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 0
            }
          }
        }
      },
      "id": "f656740a-de2a-4eb2-9d61-3df4f70c0a48",
      "name": "Aplicar correção",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        100
      ]
    },
    {
      "parameters": {
        "jiraVersion": "cloud",
        "resource": "issueComment",
        "operation": "add",
        "issueKey": "={{ $json.jira_key }}",
        "comment": "={{ ($json.ok ? 'Correção aplicada automaticamente pelo monitor-db-ia.' : 'Correção NÃO aplicada.') + '\\n\\n' + 'Banco: ' + ($json.banco || '-') + '\\n' + 'Resultado: ' + $json.mensagem + ($json.comandos && $json.comandos.length ? '\\n\\nComandos executados:\\n' + $json.comandos.join('\\n') : '') }}",
        "options": {}
      },
      "id": "df3afbf4-cc8c-4660-b48b-9a4644238fd7",
      "name": "Comentar no Jira",
      "type": "n8n-nodes-base.jira",
      "typeVersion": 1,
      "position": [
        780,
        100
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "5927632e-6bb2-4c67-af9c-eb8729174858",
              "leftValue": "={{ $('Aplicar correção').item.json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "287ba8a4-e776-48e2-9967-e6da72f4a832",
      "name": "Deu certo?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1040,
        100
      ]
    },
    {
      "parameters": {
        "jiraVersion": "cloud",
        "resource": "issue",
        "operation": "update",
        "issueKey": "={{ $('Aplicar correção').item.json.jira_key }}",
        "updateFields": {
          "labels": "={{ $('Chamados aprovados').item.json.fields.labels.concat(['corrigido']) }}"
        }
      },
      "id": "81e29e95-1de9-4378-b7ee-9c3b2c408938",
      "name": "Marcar como corrigido",
      "type": "n8n-nodes-base.jira",
      "typeVersion": 1,
      "position": [
        1300,
        0
      ]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "#incidentes-db",
          "mode": "name"
        },
        "text": "={{ ':white_check_mark: *' + $('Aplicar correção').item.json.jira_key + '* corrigido automaticamente ('+$('Aplicar correção').item.json.banco+')\\n' + $('Aplicar correção').item.json.mensagem }}",
        "otherOptions": {
          "includeLinkToWorkflow": false,
          "mrkdwn": true
        }
      },
      "id": "d75aa4ef-9fa3-4bf5-b033-f1dfac4f68fc",
      "name": "Avisar no Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [
        2080,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Chamados aprovados').item.json.self.split('/rest/')[0] + '/rest/api/3/issue/' + $('Aplicar correção').item.json.jira_key + '/transitions' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "jiraSoftwareCloudApi",
        "options": {}
      },
      "id": "d0cda359-b1e8-4e6f-bbc3-31986c6284dc",
      "name": "Buscar transições",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1560,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Chamados aprovados').item.json.self.split('/rest/')[0] + '/rest/api/3/issue/' + $('Aplicar correção').item.json.jira_key + '/transitions' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "jiraSoftwareCloudApi",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ transition: { id: $json.transitions.find(t => t.to.statusCategory.key === 'done').id } }) }}"
      },
      "id": "9f648bb9-2392-4fe3-80b6-788fa531cd73",
      "name": "Resolver chamado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1820,
        0
      ]
    }
  ],
  "connections": {
    "Executar manualmente": {
      "main": [
        [
          {
            "node": "Chamados aprovados",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "A cada 5 minutos": {
      "main": [
        [
          {
            "node": "Chamados aprovados",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Chamados aprovados": {
      "main": [
        [
          {
            "node": "Aplicar correção",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Aplicar correção": {
      "main": [
        [
          {
            "node": "Comentar no Jira",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Comentar no Jira": {
      "main": [
        [
          {
            "node": "Deu certo?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Deu certo?": {
      "main": [
        [
          {
            "node": "Marcar como corrigido",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Marcar como corrigido": {
      "main": [
        [
          {
            "node": "Buscar transições",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Buscar transições": {
      "main": [
        [
          {
            "node": "Resolver chamado",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Resolver chamado": {
      "main": [
        [
          {
            "node": "Avisar no Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}